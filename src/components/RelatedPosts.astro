const [teaPosts, godIsDeadPosts, balletPosts] = await Promise.all([
	getCollection('tea'),
	getCollection('god-is-dead'),
	getCollection('ballet'),
]);
const postTitleByPath = new Map([
	...teaPosts.map((post) => [`/tea/${post.id}`, post.data.title] as const),
	...godIsDeadPosts.map((post) => [`/god-is-dead/${post.id}`, post.data.title] as const),
	...balletPosts.map((post) => [`/ballet/${post.id}`, post.data.title] as const),
]);
const relatedPosts = (relatedByPath[currentPath] ?? []).map((href) => {
	const title = postTitleByPath.get(href);
	if (!title) throw new Error(`Related post does not exist: ${href}`);
	return { href, title };
});
---

{
	relatedPosts.length > 0 && (
		<section aria-labelledby="related-posts">
			<h2 id="related-posts">Related posts</h2>
			<ul>
				{relatedPosts.map((post) => <li><a href={post.href}>{post.title}</a></li>)}
			</ul>
		</section>
	)
}
