---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { SITE_TITLE, type TeaCategory } from '../consts';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import TeaCardGrid from './TeaCardGrid.astro';

interface Props {
	category: TeaCategory;
	posts: CollectionEntry<'tea'>[];
}

const { category, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${category.title} — Tea — ${SITE_TITLE}`}
			description={category.description}
			image={category.fixedHero ?? posts[0]?.data.heroImage}
		/>
		<style>
			main {
				width: 960px;
			}
			.category-header {
				margin-bottom: 2rem;
				text-align: center;
			}
			.category-header h1 {
				margin: 0 0 0.5rem;
			}
			.category-header p {
				margin: 0;
				color: rgb(var(--gray));
				font-size: 1em;
			}
			.category-hero img {
				display: block;
				width: 100%;
				margin: 0 auto 2rem;
				border-radius: 12px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				{
					category.fixedHero && (
						<div class="category-hero">
							<Image src={category.fixedHero} alt="" loading="eager" fetchpriority="high" />
						</div>
					)
				}
				<div class="category-header">
					<h1>{category.title}</h1>
					<p>{category.description}</p>
				</div>
				<TeaCardGrid
					items={posts.map((post) => ({
						href: `${base}tea/${post.id}/`,
						title: post.data.title,
						pubDate: post.data.pubDate,
						heroImage: post.data.heroImage,
						heroImageSrc: post.data.heroImageSrc,
						heroImageMaxHeight: post.data.heroImageMaxHeight,
					}))}
				/>
			</section>
		</main>
		<Footer />
	</body>
</html>
