---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { SITE_TITLE, type TeaCategory } from '../consts';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import TeaCardGrid from './TeaCardGrid.astro';

interface Props {
	category: TeaCategory;
	posts: CollectionEntry<'tea'>[];
}

const { category, posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullPosts =
	category.slug === 'my-teaware-collection'
		? await Promise.all(posts.map(async (post) => ({ post, Content: (await render(post)).Content })))
		: [];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${category.title} — Tea — ${SITE_TITLE}`}
			description={category.description}
			image={category.fixedHero ?? posts[0]?.data.heroImage}
		/>
		<style>
			main {
				width: 960px;
			}
			.category-header {
				margin-bottom: 2rem;
				text-align: center;
			}
			.category-header h1 {
				margin: 0 0 0.5rem;
			}
			.category-header p {
				margin: 0;
				color: rgb(var(--gray));
			}
			.category-hero img {
				display: block;
				width: 100%;
				margin: 0 auto 2rem;
				border-radius: 12px;
			}
			.collection-post {
				width: 720px;
				max-width: 100%;
				margin: 0 auto;
			}
			.collection-post h2 {
				text-align: center;
			}
			.collection-post-description {
				color: rgb(var(--gray));
				text-align: center;
			}
			.collection-post :global(figure.full-size) {
				margin: 1.5rem 0;
			}
			.collection-post :global(figure.full-size img) {
				display: block;
				width: 100%;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				{
					category.fixedHero && (
						<div class="category-hero">
							<Image src={category.fixedHero} alt="" loading="eager" fetchpriority="high" />
						</div>
					)
				}
				<div class="category-header">
					<h1>{category.title}</h1>
					<p>{category.description}</p>
				</div>
				{
					fullPosts.length > 0 ? (
						fullPosts.map(({ post, Content }) => (
							<article class="collection-post">
								<h2><a href={`${base}tea/${post.id}/`}>{post.data.title}</a></h2>
								<p class="collection-post-description">{post.data.description}</p>
								<Content />
							</article>
						))
					) : (
						<TeaCardGrid
							items={posts.map((post) => ({
								href: `${base}tea/${post.id}/`,
								title: post.data.title,
								pubDate: post.data.pubDate,
								heroImage: post.data.heroImage,
								heroImageMaxHeight: post.data.heroImageMaxHeight,
							}))}
						/>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
